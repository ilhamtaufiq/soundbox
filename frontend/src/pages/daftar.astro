---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Daftar — Soundbox QRIS" current="home">
  <section class="signup">
    <div class="signup-head">
      <h1>Daftar Soundbox QRIS</h1>
      <p class="muted">Isi data singkat di bawah. Kami akan menghubungi Anda untuk aktivasi dan informasi harga.</p>
    </div>

    <form id="signup-form" class="card form" novalidate>
      <!-- Honeypot: kolom ini disembunyikan. Bot yang mengisinya akan ditolak Web3Forms. -->
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="name">Nama lengkap <span class="req" aria-hidden="true">*</span></label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required />
      </div>

      <div class="field">
        <label for="business">Nama usaha <span class="req" aria-hidden="true">*</span></label>
        <input id="business" name="business" type="text" autocomplete="organization" required />
      </div>

      <div class="field">
        <label for="phone">Nomor WhatsApp <span class="opt">(opsional)</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="08xxxxxxxxxx" />
      </div>

      <div class="field">
        <label for="message">Kebutuhan Anda <span class="opt">(opsional)</span></label>
        <textarea id="message" name="message" rows="4" placeholder="Misalnya: jumlah kasir, atau minat pre-order alat"></textarea>
      </div>

      <button id="submit" type="submit" class="btn primary block">Kirim pendaftaran</button>

      <p id="status" class="status" role="status" aria-live="polite"></p>
    </form>

    <p class="back"><a href="/">Kembali ke beranda</a></p>
  </section>
</Layout>

<style>
  .signup { max-width: 560px; margin: 32px auto 48px; }
  .signup-head { text-align: center; margin-bottom: 24px; }
  .signup-head h1 { margin: 0 0 8px; }
  .signup-head p { margin: 0; }

  .form { display: grid; gap: 16px; padding: 24px; }
  .field { display: grid; gap: 6px; }
  .field label { color: var(--text); font-size: 0.95rem; margin: 0; }
  .req { color: var(--danger); }
  .opt { color: var(--muted); font-weight: 400; }
  .field input,
  .field textarea {
    width: 100%;
    padding: 12px 14px;
    font: inherit;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
  }
  .field textarea { resize: vertical; min-height: 96px; }
  .field input[aria-invalid='true'] { border-color: var(--danger); }
  .field .hint { color: var(--danger); font-size: 0.85rem; margin: 0; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .btn.block {
    width: 100%;
    padding: 14px 24px;
    border: none;
    border-radius: 12px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    background: var(--accent);
    color: #001219;
  }
  .btn.block:disabled { opacity: 0.6; cursor: wait; }

  .status { margin: 0; text-align: center; min-height: 1.4em; }
  .status.ok { color: var(--success); font-weight: 600; }
  .status.err { color: var(--danger); }

  .back { text-align: center; margin-top: 20px; }
  .back a { color: var(--accent); }
</style>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const status = document.getElementById('status') as HTMLParagraphElement;
  const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

  function setError(input: HTMLInputElement | HTMLTextAreaElement, message: string) {
    input.setAttribute('aria-invalid', 'true');
    let hint = input.parentElement?.querySelector<HTMLParagraphElement>('.hint');
    if (!hint) {
      hint = document.createElement('p');
      hint.className = 'hint';
      input.parentElement?.appendChild(hint);
    }
    hint.textContent = message;
  }

  function clearErrors() {
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    form.querySelectorAll('.hint').forEach((el) => el.remove());
    status.textContent = '';
    status.className = 'status';
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();

    const name = form.elements.namedItem('name') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const business = form.elements.namedItem('business') as HTMLInputElement;

    let firstInvalid: HTMLInputElement | null = null;
    if (!name.value.trim()) {
      setError(name, 'Isi nama lengkap Anda.');
      firstInvalid ??= name;
    }
    if (!email.value.trim() || !email.validity.valid) {
      setError(email, 'Isi email yang aktif, misalnya nama@email.com.');
      firstInvalid ??= email;
    }
    if (!business.value.trim()) {
      setError(business, 'Isi nama usaha Anda.');
      firstInvalid ??= business;
    }
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }

    if (!accessKey) {
      status.textContent = 'Pendaftaran belum bisa dikirim saat ini. Silakan hubungi kami lewat email.';
      status.className = 'status err';
      return;
    }

    submit.disabled = true;
    submit.textContent = 'Mengirim…';

    const data = Object.fromEntries(new FormData(form).entries());
    const payload = {
      access_key: accessKey,
      subject: `Pendaftaran baru: ${data.business}`,
      from_name: 'Soundbox QRIS',
      name: data.name,
      email: data.email,
      business: data.business,
      phone: data.phone || '-',
      message: data.message || '-',
      botcheck: data.botcheck ? true : false,
    };

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (result.success) {
        form.reset();
        form.hidden = true;
        status.textContent = 'Terima kasih! Pendaftaran Anda sudah kami terima. Kami akan menghubungi Anda lewat email.';
        status.className = 'status ok';
        status.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        throw new Error(result.message || 'gagal');
      }
    } catch {
      status.textContent = 'Pendaftaran belum terkirim. Periksa koneksi Anda lalu coba lagi.';
      status.className = 'status err';
      submit.disabled = false;
      submit.textContent = 'Kirim pendaftaran';
    }
  });
</script>
