# Koneksi MySQL
DATABASE_URL=mysql://root:@localhost:3306/gobiz_soundbox

# Alamat server dan origin frontend yang boleh akses (CORS)
BIND_ADDR=127.0.0.1:8080
CORS_ORIGIN=http://localhost:4321

# Login admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
JWT_SECRET=ganti-dengan-string-acak-panjang

# Rahasia untuk endpoint internal (dipakai watcher pembayaran)
INTERNAL_SECRET=ganti-dengan-string-acak-lain


